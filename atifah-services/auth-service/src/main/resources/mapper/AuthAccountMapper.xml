<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atifah.auth.mapper.AuthAccountMapper">

    <resultMap id="AuthAccountMap" type="com.atifah.auth.entity.AuthAccount">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="phone" property="phone"/>
        <result column="password_hash" property="passwordHash"/>
        <result column="status" property="status"/>
        <result column="last_login_at" property="lastLoginAt"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <select id="selectByPhone" resultMap="AuthAccountMap">
        SELECT id, user_id, phone, password_hash, status, last_login_at, created_at, updated_at, deleted
        FROM t_auth_account
        WHERE phone = #{phone}
          AND deleted = 0
    </select>

    <insert id="insert" parameterType="com.atifah.auth.entity.AuthAccount">
        INSERT INTO t_auth_account (id, user_id, phone, password_hash, status)
        VALUES (#{id}, #{userId}, #{phone}, #{passwordHash}, #{status})
    </insert>

    <update id="updateLastLoginAt">
        UPDATE t_auth_account
        SET last_login_at = #{lastLoginAt}
        WHERE id = #{id}
          AND deleted = 0
    </update>
</mapper>
