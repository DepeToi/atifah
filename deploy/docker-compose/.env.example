# 本地中间件环境变量示例：复制为同目录下的 .env 后生效（.env 已被 .gitignore 忽略，禁止入库）
#
# Nacos 3 启动脚本强制校验 NACOS_AUTH_TOKEN：base64 字符串，解码后必须 >=32 字节。
# 生成方式（任选其一）：
#   printf 'atifah-nacos-dev-2026-0123456789' | base64
#   openssl rand -base64 32
NACOS_AUTH_TOKEN=

# 以下为方案 B（docker-compose.app.yml）可选变量，按需取消注释：
# 基础镜像；国内网络可换成可用镜像源（示例：docker.m.daocloud.io/library/eclipse-temurin:21-jre-jammy）
#BASE_IMAGE=eclipse-temurin:21-jre-jammy
# 单个后端容器内存上限
#APP_MEM_LIMIT=1g
# Nacos 命名空间，需与中间件配置导入时一致
#NACOS_NAMESPACE=atifah_dev
